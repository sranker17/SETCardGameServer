# Production Environment Variables Template
# Copy this file to production.env and fill in your actual values
# The production.env file should not be committed to version control

# Database Configuration
SPRING_DATASOURCE_URL=jdbc:mysql://your-database-host:3306/your-database
SPRING_DATASOURCE_USERNAME=your-db-username
SPRING_DATASOURCE_PASSWORD=your-db-password

# JWT Security
JWT_SECRET=your-very-strong-jwt-secret-key
JWT_EXPIRATION_TIME=3600000
