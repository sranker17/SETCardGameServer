# Production Environment Variables Template
# Copy this file to production.env and fill in your actual values
# The production.env file should not be committed to version control

# Database Configuration
DB_URL=jdbc:mysql://your-database-host:3306/your-database
DB_USERNAME=your-db-username
DB_PASSWORD=your-db-password

# JWT Security
JWT_SECRET=your-very-strong-jwt-secret-key
JWT_EXPIRATION_TIME=3600000

# Super Admin Credentials
SUPER_ADMIN_USERNAME=admin
SUPER_ADMIN_PASSWORD=your-super-admin-password